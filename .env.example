HTTP_PORT=32488
HOST_IP=<your host IP>
CLIENT_PROFILE=DLNA
ENABLE_ONBOARDING_WIZARD=1
LOG_LEVEL=INFO # DEBUG|INFO|WARNING|ERROR|CRITICAL

# Optional overrides — SonoPlay discovers and caches Plex settings at runtime
# (config/plex_runtime_cache.json, config/plex_dlna_discovery.json, config/dlna_reject_cache.json).
# Set these only when auto-discovery fails or for a non-standard setup.

# Plex DLNA (Stream Magic) — or rely on SSDP cache after Plex is seen on the network
# PLEX_DLNA_DEVICE_URL=http://<pms-host>:32469/DeviceDescription.xml
# PLEX_DLNA_PORT=32469

# Plex PMS API — token usually comes from device pairing; override if needed
# PLEX_PMS_TOKEN=
# PLEX_PMS_PORT=32400
# PLEX_MUSIC_LIBRARY_KEY=

# Plex DLNA browse roots — auto-discovered on first SM6 stream resolve
# PLEX_DLNA_MUSIQUE_ID=
# PLEX_DLNA_MUSIC_FOLDER_ID=

# Optional: Plex server name as shown on the SM6 (audio source id 10)
# SM6_PLEX_NAVIGATOR_NAME=MyPlexServer
# SM6_PLEXAMP_VOLUME_STEP_ENABLED=1

# Audio transcode proxy kbps
# AUDIO_TRANSCODE_PROXY_KBPS=320

# MP3 transcode cache TTL (hours, default 96)
# TRANSCODE_CACHE_TTL_HOURS=96
